{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "esnext",
    "types": [],
    
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Recommended Options
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  },
  // excluir ficheros .ts q no procesan de typeScript como hls
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ],
  "include": [
    "src"
  ]
}